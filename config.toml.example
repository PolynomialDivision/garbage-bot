[matrix]
homeserver = "https://matrix.org"
user_id = "@yourbotname:matrix.org"
# Secrets may instead come from MATRIX_ACCESS_TOKEN / MATRIX_RECOVERY_KEY.
access_token = "YOUR_ACCESS_TOKEN"
device_id = "YOUR_DEVICE_ID"
# Optional: security key from Element's "Set up Secure Backup"
# Needed once to self-sign the bot's device (removes "not verified by owner" warning).
# Steps: log in as bot in Element Web → Settings → Security → Set up Secure Backup → generate key
# After first successful run showing "Cross-signing bootstrapped", remove this line.
# recovery_key = "EsXX xxxx xxxx xxxx xxxx xxxx xxxx xxxx"

[bsr]
# Option A: let the bot resolve your schedule_id from your address at startup.
# The resolved ID is logged: copy it into Option B for faster future startups.
street = "Musterstraße"
number = "1"
plz = "12345"

# Option B: set schedule_id directly (faster startup, skip the API lookup).
# schedule_id = "YOUR_SCHEDULE_ID"

# Optional: Berlin Recycling customer portal for paper (Altpapier) collection.
# If omitted, only BSR pickups are tracked.
# Register at https://kundenportal.berlin-recycling.de/
[berlin_recycling]
username = "your@email.de"
password = "yourpassword"
# If your password contains backslashes or special chars, use single quotes:
# password = 'your\password'

# Both values are defaults: admins can change them at runtime with
# `!admin set reminder_time 19:30` (persisted in store/settings.json;
# `!admin unset <key>` reverts to this file).
[reminder]
# Local time (24h) to send the reminder the evening before pickup
reminder_time = "20:00"
# How long (in minutes) a reminder keeps retrying after becoming due before
# it's given up on as stale (default: 720 = 12h). Retries during this window
# survive Matrix outages and bot restarts; past it, the "put them out
# tonight" message would just be misleading, so it's dropped and logged
# instead of delivered late.
# max_lateness_minutes = 720
# If nobody has reacted with ✅ this many minutes after the reminder, the bot
# posts one follow-up as a reply to it (default: 120; 0 = never). No follow-up
# is sent after 06:00 on collection day.
# followup_minutes = 120

[security]
# Users allowed to run admin commands, privately in a
# direct chat with the bot (send !admin there for help).
admin_users = ["@you:matrix.org"]

# Users allowed to invite the bot ("all" = anyone, [] = nobody).
# Configured admins may always open a direct chat with the bot.
allowed_inviters = ["@you:matrix.org"]

# Which devices receive room keys:
#   identity_based: only cross-signed devices (default, recommended)
#   only_trusted: only explicitly verified devices
#   all_devices: all devices, no restriction
encryption_strategy = "all_devices"

# Waste type labels (override to customise names shown in reminders)
[waste_labels]
# BSR codes
HM = "Residual Waste (grey)"
BI = "Organic Waste (brown)"
WS = "Recyclables (yellow)"
LT = "Garden Waste (green)"
WB = "Christmas Tree"
# Berlin Recycling labels (after stripping leading category code)
"Altpapier, gemischt" = "Paper (blue)"

# Optional: color each label in the Matrix message (HTML clients only)
[waste_colors]
"Residual Waste (grey)"  = "#808080"
"Organic Waste (brown)"  = "#6B8E23"
"Recyclables (yellow)"   = "#DAA520"
"Garden Waste (green)"   = "#556B2F"
"Christmas Tree"         = "#006400"
"Paper (blue)"           = "#4682B4"

[security.verification]
# Users allowed to complete first-time verification. If omitted or empty,
# an explicit allowed_inviters list is used as the fallback.
allowed_users = ["@you:matrix.org"]
# Also allow first-time verification for users sharing a joined room with the bot.
allow_users_from_joined_rooms = false
# SAS-only verification limits.
flow_timeout_secs = 300
grant_ttl_secs = 600
max_concurrent = 8

[security.admin_dm]
# Admins can open a direct chat with the bot and manage it there:
#   !admin status | verify | settings | set <key> <value> | unset <key>
# `!admin verify` starts mutual emoji (SAS) verification with you.
enabled = true
# Only accept admin commands in end-to-end encrypted direct chats.
require_encryption = true
# Only accept admin commands from devices the bot has verified (recommended
# once you and the bot have verified each other).
require_verified_device = false
# Also deliver broadcast posts (summaries, digests, …) into admin chats.
receive_broadcasts = false
